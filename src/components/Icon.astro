---
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
  label?: string;
}

const { name, size = 24, strokeWidth = 1.6, class: className, label } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <path d={icons[name]}></path>
</svg>
