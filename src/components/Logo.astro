---
import { site } from '../site.config';
import type { Lang } from '../i18n/utils';
import { logoPaths, logoTasselEnd, logoViewBox } from '../data/logo';

interface Props {
  /** Logo 文字依語言顯示品牌名稱 */
  lang: Lang;
  /** 圖形標誌高度（px） */
  size?: number;
  /** 只顯示圖形標誌 */
  markOnly?: boolean;
  /** 放在深色背景上 */
  inverted?: boolean;
}

const { lang, size = 36, markOnly = false, inverted = false } = Astro.props;
// 圖形只占 48 格線中的 x 5–43、y 3–46，裁掉四周留白
const width = Math.round((size * 38) / 43);
---

<span class:list={['logo', { 'logo--inverted': inverted }]}>
  <!-- 圖形「Mentor Bubble」：戴學士帽的對話框，框內是 AI 火花；帽子與對話框之間的 V 形缺口是鏤空 -->
  <svg class="logo-mark" width={width} height={size} viewBox={logoViewBox} aria-hidden="true" focusable="false">
    <path class="logo-bubble" d={logoPaths.bubble}></path>
    <path class="logo-cap" d={logoPaths.cap}></path>
    <path class="logo-tassel" d={logoPaths.tassel} fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
    <circle class="logo-tassel-end" {...logoTasselEnd}></circle>
    <path class="logo-spark" d={logoPaths.spark}></path>
  </svg>
  {!markOnly && <span class="logo-word">{site.name[lang]}</span>}
</span>

<style>
  .logo {
    --logo-bubble: var(--primary);
    --logo-cap: var(--ink);
    --logo-spark: var(--on-primary);
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--ink);
  }

  .logo--inverted {
    --logo-bubble: var(--on-primary);
    --logo-cap: var(--on-primary);
    --logo-spark: var(--primary);
    color: var(--on-primary);
  }

  .logo-mark {
    flex-shrink: 0;
  }

  .logo-bubble {
    fill: var(--logo-bubble);
  }

  .logo-cap {
    fill: var(--logo-cap);
  }

  .logo-tassel {
    stroke: var(--accent);
  }

  .logo-tassel-end {
    fill: var(--accent);
  }

  .logo-spark {
    fill: var(--logo-spark);
  }

  .logo-word {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1;
  }
</style>
