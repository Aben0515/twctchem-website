---
import { site } from '../site.config';

interface Props {
  /** 圖形標誌邊長（px） */
  size?: number;
  /** 只顯示圖形標誌 */
  markOnly?: boolean;
  /** 放在深色背景上 */
  inverted?: boolean;
}

const { size = 34, markOnly = false, inverted = false } = Astro.props;
---

<span class:list={['logo', { 'logo--inverted': inverted }]}>
  <!-- 圖形：墨綠底上一本攤開的書，右頁夾著陶土橘書籤 -->
  <svg class="logo-mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="8" fill="var(--logo-tile, #1F4D3A)"></rect>
    <path d="M7.5 10.2c3-1 6-.6 8.5 1.3v11.6c-2.5-1.6-5.5-2-8.5-1.1z" fill="#FAF7F2"></path>
    <path d="M24.5 10.2c-3-1-6-.6-8.5 1.3v11.6c2.5-1.6 5.5-2 8.5-1.1z" fill="#FAF7F2" opacity="0.78"></path>
    <path d="M19.6 9.4h2.6v5.4l-1.3-1-1.3 1z" fill="#D97757"></path>
  </svg>
  {!markOnly && <span class="logo-word">{site.shortName}</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--ink);
  }

  .logo--inverted {
    color: var(--on-primary);
    --logo-tile: #faf7f2;
  }

  .logo--inverted .logo-mark path:not(:last-child) {
    fill: var(--primary);
  }

  .logo-word {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1;
  }
</style>
