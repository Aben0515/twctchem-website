---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'start' | 'center';
  /** 標題層級，預設 h2 */
  as?: 'h1' | 'h2';
}

const { eyebrow, title, lead, align = 'start', as: Tag = 'h2' } = Astro.props;
---

<header class:list={['section-heading', `section-heading--${align}`]} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag>{title}</Tag>
  {lead && <p class="lead">{lead}</p>}
</header>

<style>
  .section-heading {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .section-heading--center {
    justify-items: center;
    margin-inline: auto;
    text-align: center;
  }
</style>
