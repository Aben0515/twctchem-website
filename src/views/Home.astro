---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProductCard from '../components/ProductCard.astro';
import CTABanner from '../components/CTABanner.astro';
import HeroDemo from '../components/HeroDemo.astro';
import type { IconName } from '../components/icons';
import { products } from '../data/products';
import { site } from '../site.config';
import { type Lang, localizePath, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = t.home;
const otherLang: Lang = lang === 'en' ? 'zh-TW' : 'en';
---

<BaseLayout lang={lang}>
  <!-- Hero：品牌字標當主標題，標語當副標 -->
  <section class="hero">
    <div class="hero-lines" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{home.hero.eyebrow}</p>
        <h1 class="brand-title">
          <span class="brand-primary">{site.name[lang]}</span>
          <span class="brand-secondary" lang={otherLang}>{site.name[otherLang]}</span>
        </h1>
        <p class="hero-tagline" set:html={home.hero.tagline} />
        <p class="lead">{home.hero.lead}</p>
        <div class="hero-actions">
          <a class="btn btn--primary" href={localizePath(lang, '/products/')}>
            {home.hero.primary}
            <Icon name="arrow" size={18} />
          </a>
          <a class="btn btn--secondary" href={localizePath(lang, '/contact/')}>{home.hero.secondary}</a>
        </div>
        <p class="hero-note">
          <span>{home.hero.note}</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
      <div class="hero-art">
        <HeroDemo lang={lang} label={home.hero.illustrationLabel} />
      </div>
    </div>
  </section>

  <!-- 名字的由來：hero 與內容之間的停頓點 -->
  <section class="story">
    <div class="container story-inner" data-reveal>
      <span class="story-ornament" aria-hidden="true"><i></i></span>
      <p class="eyebrow">{home.story.eyebrow}</p>
      <p class="story-quote">{home.story.quote}</p>
      <p class="story-body">{home.story.body}</p>
    </div>
  </section>

  <!-- 服務對象 -->
  <section class="section section--audience">
    <div class="container">
      <SectionHeading eyebrow={home.audience.eyebrow} title={home.audience.title} lead={home.audience.lead} />
      <ul class="audience-grid" role="list">
        {
          home.audience.items.map((item, index) => (
            <li class="audience-card" data-reveal style={`--reveal-delay: ${index * 0.08}s`}>
              <span class="audience-icon">
                <Icon name={item.icon as IconName} size={26} />
              </span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 產品 -->
  <section class="section section--products">
    <div class="container">
      <div class="heading-row">
        <SectionHeading eyebrow={home.products.eyebrow} title={home.products.title} lead={home.products.lead} />
        <a class="link-arrow heading-link" href={localizePath(lang, '/products/')}>
          {home.products.viewAll}
          <Icon name="arrow" size={18} />
        </a>
      </div>
      <ul class="product-grid" role="list">
        {
          products.map((product, index) => (
            <li data-reveal style={`--reveal-delay: ${index * 0.08}s`}>
              <ProductCard product={product} lang={lang} />
            </li>
          ))
        }
        <li data-reveal style={`--reveal-delay: ${products.length * 0.08}s`}>
          <div class="more-card">
            <span class="more-icon"><Icon name="sparkle" size={26} /></span>
            <h3>{home.products.moreTitle}</h3>
            <p>{home.products.moreBody}</p>
            <a class="link-arrow" href={localizePath(lang, '/contact/')}>
              {home.products.moreCta}
              <Icon name="arrow" size={18} />
            </a>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- 為什麼選擇我們 -->
  <section class="section section--why">
    <div class="container">
      <SectionHeading eyebrow={home.why.eyebrow} title={home.why.title} />
      <ol class="why-grid" role="list">
        {
          home.why.items.map((item, index) => (
            <li class="why-item" data-reveal style={`--reveal-delay: ${index * 0.08}s`}>
              <span class="why-number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CTABanner
    title={home.cta.title}
    body={home.cta.body}
    buttonLabel={home.cta.button}
    href={localizePath(lang, '/contact/')}
    email={site.email}
  />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) clamp(2.5rem, 2rem + 2vw, 4.5rem);
  }

  /* 像筆記本橫線的淡背景，往外漸隱 */
  .hero-lines {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(to bottom, transparent 0 39px, rgb(214 206 191 / 0.45) 39px 40px);
    mask-image: radial-gradient(ellipse 70% 70% at 70% 45%, #000 10%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 70% 45%, #000 10%, transparent 75%);
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .hero-copy {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
  }

  /* 品牌字標：主語言名稱大字，另一語言名稱小字 */
  .brand-title {
    display: grid;
    gap: 0.9rem;
    margin-top: 0.25rem;
  }

  .brand-primary {
    font-size: clamp(3.25rem, 2rem + 5vw, 6rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: 0.06em;
    color: var(--ink);
  }

  :lang(en) .brand-primary {
    letter-spacing: -0.02em;
  }

  .brand-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: var(--fs-14);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }

  .brand-secondary::before {
    content: '';
    width: 1.75rem;
    height: 1px;
    background: currentColor;
  }

  .hero-tagline {
    max-width: 16em;
    margin-top: 0.5rem;
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-wrap: balance;
  }

  :lang(en) .hero-tagline {
    letter-spacing: -0.01em;
  }

  .hero-tagline :global(.nw) {
    white-space: nowrap;
  }

  .hero-tagline :global(em) {
    font-style: normal;
    color: var(--primary);
    background-image: linear-gradient(transparent 68%, rgb(217 119 87 / 0.3) 68%, rgb(217 119 87 / 0.3) 92%, transparent 92%);
    padding-inline: 0.06em;
  }

  .hero-copy .lead {
    max-width: 34rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .hero-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    font-size: var(--fs-14);
    color: var(--ink-subtle);
  }

  .hero-note span::after {
    content: '';
    display: inline-block;
    width: 1px;
    height: 0.9em;
    margin-left: 0.75rem;
    vertical-align: -0.1em;
    background: var(--line-strong);
  }

  .hero-note a {
    color: var(--ink-muted);
    border-bottom: 1px solid var(--line-strong);
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .hero-note a:hover {
    color: var(--primary);
    border-bottom-color: currentColor;
  }

  .hero-art {
    width: min(100%, 560px);
    justify-self: center;
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.05fr 1fr;
      gap: 2rem;
    }

    .hero-art {
      justify-self: end;
      margin-right: -1rem;
    }
  }

  /* ---------- 名字的由來 ---------- */
  .story {
    padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem) clamp(3rem, 2rem + 3vw, 5rem);
  }

  .story-inner {
    display: grid;
    justify-items: center;
    gap: 1rem;
    max-width: calc(40rem + var(--gutter) * 2);
    text-align: center;
  }

  /* 細線、陶土橘小圓點、細線 */
  .story-ornament {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .story-ornament::before,
  .story-ornament::after {
    content: '';
    width: 3.5rem;
    height: 1px;
    background: var(--line-strong);
  }

  .story-ornament i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* 置中的 eyebrow 不需要前導線 */
  .story-inner .eyebrow::before {
    display: none;
  }

  .story-quote {
    font-family: var(--font-serif);
    font-size: clamp(var(--fs-28), 1.3rem + 1.6vw, 2.5rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.08em;
    color: var(--primary);
  }

  :lang(en) .story-quote {
    letter-spacing: 0;
    font-style: italic;
  }

  .story-body {
    font-size: var(--fs-18);
    line-height: 1.85;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  /* ---------- 服務對象 ---------- */
  /* 上下以漸層融入相鄰區塊，不切硬邊 */
  .section--audience {
    background: linear-gradient(
      var(--bg),
      var(--surface) 8rem,
      var(--surface) calc(100% - 8rem),
      var(--bg-alt)
    );
  }

  .audience-grid {
    display: grid;
    gap: 1.25rem;
  }

  .audience-card {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 2rem 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg);
  }

  .audience-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 0.5rem;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--primary);
  }

  .audience-card p {
    color: var(--ink-muted);
  }

  @media (min-width: 768px) {
    .audience-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ---------- 產品 ---------- */
  /* 底部漸層回到米白，接上「我們的堅持」 */
  .section--products {
    padding-top: clamp(3rem, 2rem + 3vw, 5rem);
    background: linear-gradient(var(--bg-alt), var(--bg-alt) calc(100% - 8rem), var(--bg));
  }

  /* 漸層已經提供過渡，上方不再疊一整段留白 */
  .section--why {
    padding-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .heading-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0 2rem;
  }

  .heading-link {
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .product-grid {
    display: grid;
    gap: 1.25rem;
  }

  .product-grid > li {
    display: flex;
    flex-direction: column;
  }

  .more-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    height: 100%;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    border: 1.5px dashed var(--line-strong);
    border-radius: var(--radius-lg);
    background: transparent;
  }

  .more-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 0.5rem;
    border-radius: 14px;
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .more-card h3 {
    font-size: var(--fs-28);
  }

  .more-card p {
    color: var(--ink-muted);
  }

  .more-card .link-arrow {
    margin-top: auto;
  }

  @media (min-width: 768px) {
    .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* 落單的最後一張卡片佔滿整列 */
  @media (min-width: 768px) {
    .product-grid > li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  /* ---------- 為什麼選擇我們 ---------- */
  .why-grid {
    display: grid;
    gap: 2.5rem;
  }

  .why-item {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line-strong);
  }

  .why-number {
    font-family: var(--font-serif);
    font-size: var(--fs-36);
    font-weight: 500;
    line-height: 1;
    color: var(--accent);
  }

  .why-item p {
    color: var(--ink-muted);
  }

  @media (min-width: 768px) {
    .why-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem;
    }
  }
</style>
