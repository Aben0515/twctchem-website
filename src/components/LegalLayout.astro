---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from './SectionHeading.astro';
import { site } from '../site.config';
import { type Lang, fill, formatDate, useTranslations } from '../i18n/utils';

interface Block {
  subheading?: string;
  text?: string;
  items?: string[];
}

interface Section {
  heading: string;
  blocks: Block[];
}

interface Props {
  lang: Lang;
  title: string;
  lead: string;
  description: string;
  sections: Section[];
}

const { lang, title, lead, description, sections } = Astro.props;
const t = useTranslations(lang);

const vars = { company: site.legalName[lang], brand: site.name[lang], email: site.email };
const f = (text: string) => fill(text, vars);
---

<BaseLayout lang={lang} title={title} description={f(description)}>
  <section class="section section--page">
    <div class="container">
      <SectionHeading as="h1" eyebrow={t.legal.updated + (lang === 'en' ? ': ' : '：') + formatDate(lang, site.legalUpdated)} title={title} lead={f(lead)} />
    </div>
  </section>

  <section class="section">
    <div class="container legal-grid">
      <nav class="legal-toc" aria-label={t.legal.toc}>
        <p class="toc-title">{t.legal.toc}</p>
        <ol role="list">
          {sections.map((section, index) => <li><a href={`#section-${index + 1}`}>{section.heading}</a></li>)}
        </ol>
      </nav>

      <div class="legal-body">
        {
          sections.map((section, index) => (
            <section class="legal-section" id={`section-${index + 1}`}>
              <h2>{section.heading}</h2>
              {section.blocks.map((block) => (
                <div class="legal-block">
                  {block.subheading && <h3>{block.subheading}</h3>}
                  {block.text && <p>{f(block.text)}</p>}
                  {block.items && (
                    <ul>
                      {block.items.map((item) => <li>{f(item)}</li>)}
                    </ul>
                  )}
                </div>
              ))}
            </section>
          ))
        }

        <p class="legal-contact">
          {t.legal.questions} <a href={`mailto:${site.email}`}>{site.email}</a>{lang === 'en' ? '.' : '。'}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-grid {
    display: grid;
    gap: 2.5rem;
  }

  .legal-toc {
    font-size: var(--fs-14);
  }

  .toc-title {
    margin-bottom: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--ink-subtle);
  }

  .legal-toc ol {
    display: grid;
    gap: 0.25rem;
  }

  .legal-toc a {
    display: block;
    padding: 0.2rem 0;
    color: var(--ink-muted);
    transition: color 0.2s var(--ease);
  }

  .legal-toc a:hover {
    color: var(--primary);
  }

  .legal-body {
    max-width: 46rem;
  }

  .legal-section {
    padding-block: 2rem;
    border-top: 1px solid var(--line);
  }

  .legal-section:first-of-type {
    padding-top: 0;
    border-top: 0;
  }

  .legal-section h2 {
    margin-bottom: 1rem;
    font-size: var(--fs-22);
  }

  .legal-block + .legal-block {
    margin-top: 1.25rem;
  }

  .legal-block h3 {
    margin-bottom: 0.4rem;
    font-family: var(--font-sans);
    font-size: var(--fs-16);
    font-weight: 600;
  }

  .legal-block p {
    color: var(--ink-muted);
  }

  .legal-block p + ul {
    margin-top: 0.5rem;
  }

  .legal-block ul {
    display: grid;
    gap: 0.4rem;
    padding-left: 1.25rem;
    color: var(--ink-muted);
  }

  .legal-block li::marker {
    color: var(--accent);
  }

  .legal-contact {
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
  }

  .legal-contact a {
    color: var(--primary);
    border-bottom: 1px solid var(--line-strong);
  }

  @media (min-width: 960px) {
    .legal-grid {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: 4rem;
    }

    .legal-toc {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      align-self: start;
    }
  }
</style>
