---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTABanner from '../components/CTABanner.astro';
import { faqs, type FaqCategory } from '../data/faq';
import { site } from '../site.config';
import { type Lang, fill, localizePath, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const page = t.faq;

const categories: FaqCategory[] = ['product', 'cooperation', 'privacy'];
const groups = categories.map((key) => ({
  key,
  title: page.categories[key],
  items: faqs.filter((item) => item.category === key),
}));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question[lang],
    acceptedAnswer: { '@type': 'Answer', text: item.answer[lang].join('\n') },
  })),
};
---

<BaseLayout lang={lang} title={page.meta.title} description={page.meta.description}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="section section--page">
    <div class="container">
      <SectionHeading as="h1" eyebrow={page.hero.eyebrow} title={page.hero.title} lead={page.hero.lead} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="faq-layout">
      {
        groups.map((group) => (
          <section class="faq-group" aria-labelledby={`faq-${group.key}`}>
            <h2 id={`faq-${group.key}`} data-reveal>
              {group.title}
            </h2>
            <div class="faq-list" data-reveal>
              {group.items.map((item) => (
                <details class="faq-item">
                  <summary>
                    <span>{item.question[lang]}</span>
                    <span class="faq-toggle" aria-hidden="true" />
                  </summary>
                  <div class="faq-answer">
                    {item.answer[lang].map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))
      }
      </div>
    </div>
  </section>

  <CTABanner
    title={page.cta.title}
    body={fill(page.cta.body, { days: site.replyWithinDays })}
    buttonLabel={page.cta.button}
    href={localizePath(lang, '/contact/')}
    email={site.email}
  />
</BaseLayout>

<style>
  .faq-layout {
    display: grid;
    gap: clamp(3rem, 2rem + 3vw, 4.5rem);
    max-width: 52rem;
  }

  .faq-group {
    display: grid;
    gap: 1.25rem;
  }

  .faq-group h2 {
    font-size: var(--fs-28);
  }

  .faq-list {
    border-top: 1px solid var(--line-strong);
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.25rem;
    font-weight: 500;
    line-height: 1.6;
    cursor: pointer;
    list-style: none;
    transition: color 0.2s var(--ease);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary:hover {
    color: var(--primary);
  }

  /* 加號圖示：開啟時橫線旋轉成減號 */
  .faq-toggle {
    position: relative;
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--accent-strong);
  }

  .faq-toggle::before,
  .faq-toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.25s var(--ease);
  }

  .faq-toggle::after {
    transform: rotate(90deg);
  }

  .faq-item[open] .faq-toggle::after {
    transform: rotate(0deg);
  }

  .faq-answer {
    display: grid;
    gap: 0.75rem;
    padding-bottom: 1.5rem;
    color: var(--ink-muted);
  }
</style>
